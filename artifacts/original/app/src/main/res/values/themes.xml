<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AbdurahimInventoryAppProjectTwo" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/inventory_background</item>
        <item name="android:statusBarColor">@color/inventory_background</item>
        <item name="colorPrimary">@color/inventory_primary</item>
        <item name="colorSecondary">@color/inventory_accent</item>
    </style>

    <style name="Theme.AbdurahimInventoryAppProjectTwo" parent="Base.Theme.AbdurahimInventoryAppProjectTwo" />

    <style name="InventoryTableHeader">
        <item name="android:layout_width">112dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">10dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="InventoryTableCell">
        <item name="android:layout_width">112dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">10dp</item>
        <item name="android:textColor">@color/inventory_text_primary</item>
    </style>

    <style name="InventoryDeleteButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">100dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:textColor">@color/inventory_danger</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="InventoryGridHeader">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">10dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
