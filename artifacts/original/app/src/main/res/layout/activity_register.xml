<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/registerMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/inventory_background"
    android:fillViewport="true"
    tools:context=".RegisterActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/textRegisterTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/register_title"
            android:textColor="@color/inventory_primary_dark"
            android:textSize="30sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/textRegisterSubtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/textRegisterSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/register_subtitle"
            android:textColor="@color/inventory_text_secondary"
            android:textSize="16sp"
            app:layout_constraintBottom_toTopOf="@id/textRegisterUsernameLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textRegisterTitle" />

        <TextView
            android:id="@+id/textRegisterUsernameLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/username_label"
            android:textColor="@color/inventory_text_primary"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/editTextRegisterUsername"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textRegisterSubtitle" />

        <EditText
            android:id="@+id/editTextRegisterUsername"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:autofillHints="username"
            android:background="@drawable/edit_text_background"
            android:hint="@string/username_hint"
            android:inputType="text"
            android:minHeight="52dp"
            android:padding="14dp"
            android:singleLine="true"
            android:textColor="@color/inventory_text_primary"
            android:textColorHint="@color/inventory_text_hint"
            app:layout_constraintBottom_toTopOf="@id/textRegisterPasswordLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textRegisterUsernameLabel" />

        <TextView
            android:id="@+id/textRegisterPasswordLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/password_label"
            android:textColor="@color/inventory_text_primary"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/editTextRegisterPassword"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/editTextRegisterUsername" />

        <EditText
            android:id="@+id/editTextRegisterPassword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:autofillHints="password"
            android:background="@drawable/edit_text_background"
            android:hint="@string/password_hint"
            android:inputType="textPassword"
            android:minHeight="52dp"
            android:padding="14dp"
            android:singleLine="true"
            android:textColor="@color/inventory_text_primary"
            android:textColorHint="@color/inventory_text_hint"
            app:layout_constraintBottom_toTopOf="@id/buttonRegisterAccount"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textRegisterPasswordLabel" />

        <Button
            android:id="@+id/buttonRegisterAccount"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/inventory_primary"
            android:text="@string/register_button"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:layout_constraintBottom_toTopOf="@id/buttonBackToLogin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/editTextRegisterPassword" />

        <Button
            android:id="@+id/buttonBackToLogin"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="@string/back_to_login_button"
            android:textAllCaps="false"
            android:textColor="@color/inventory_primary"
            app:strokeColor="@color/inventory_primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/buttonRegisterAccount" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
