<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/smsMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/inventory_background"
    android:fillViewport="true"
    tools:context=".SmsPermissionActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/textSmsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/sms_title"
            android:textColor="@color/inventory_primary_dark"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/textSmsDescription"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/textSmsDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/sms_description"
            android:textColor="@color/inventory_text_secondary"
            android:textSize="16sp"
            app:layout_constraintBottom_toTopOf="@id/textPermissionStatus"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textSmsTitle" />

        <TextView
            android:id="@+id/textPermissionStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="@drawable/status_background"
            android:padding="16dp"
            android:textColor="@color/inventory_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/textNotificationPreview"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textSmsDescription"
            tools:text="@string/sms_permission_denied" />

        <TextView
            android:id="@+id/textNotificationPreview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/inventory_text_secondary"
            android:textSize="15sp"
            app:layout_constraintBottom_toTopOf="@id/buttonRequestSmsPermission"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textPermissionStatus"
            tools:text="@string/sms_low_inventory_disabled" />

        <Button
            android:id="@+id/buttonRequestSmsPermission"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/inventory_primary"
            android:text="@string/request_sms_button"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:layout_constraintBottom_toTopOf="@id/buttonContinueInventory"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textNotificationPreview" />

        <Button
            android:id="@+id/buttonContinueInventory"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="@string/continue_inventory_button"
            android:textAllCaps="false"
            android:textColor="@color/inventory_primary"
            app:strokeColor="@color/inventory_primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/buttonRequestSmsPermission" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
