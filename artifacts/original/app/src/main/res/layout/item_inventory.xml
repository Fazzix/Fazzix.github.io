<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/item_card_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/textItemName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/inventory_text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textItemQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/inventory_text_secondary"
        android:textSize="14sp" />

    <Button
        android:id="@+id/buttonSelectItem"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:text="@string/select_button"
        android:textAllCaps="false"
        android:textColor="@color/inventory_primary" />

    <Button
        android:id="@+id/buttonDeleteItem"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/delete_button"
        android:textAllCaps="false"
        android:textColor="@color/inventory_danger" />
</LinearLayout>
